#---LinkDriver.test--------------------- Executable------------------#
#BEGIN_COMMENT
# The X86 family hooks should invoke the existing x86_64 emulation and backend.
#--------------------------------------------------------------------
#END_COMMENT
#
RUN: %clang -target x86_64 -c %p/Inputs/1.c -o %t1.o
RUN: %link %linkopts %emulation %t1.o -o %t1.out
RUN: %readelf -h %t1.out | %filecheck %s

CHECK: Class:                              ELF64
CHECK: Machine: {{.*}}X86-64
